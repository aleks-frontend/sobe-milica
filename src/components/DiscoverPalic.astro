---
import { translations } from '../data/content';
const t = translations.sr;
---

<section id="palic" style="scroll-margin-top:80px;background:#2E332A;color:#F4EEE1;padding:clamp(70px,11vh,140px) clamp(20px,5vw,60px);position:relative;overflow:hidden">
  <div style="max-width:1240px;margin:0 auto;position:relative;z-index:1">
    <div class="reveal" style="text-align:center;max-width:660px;margin:0 auto 56px">
      <div class="tri-col" style="width:20px;height:58px;margin:0 auto 24px;opacity:.9"></div>
      <div class="lbl-orn" data-i18n="palicLabel" style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#B9A57E;font-weight:600;margin-bottom:14px">{t.palicLabel}</div>
      <h2 data-i18n="palicHeading" style="font-size:clamp(34px,5.4vw,64px);color:#F7F2E6">{t.palicHeading}</h2>
      <p data-i18n="palicSub" style="font-size:17px;line-height:1.7;color:#C7C6B8;margin:20px 0 0">{t.palicSub}</p>
    </div>
    <div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px">
      {t.attractions.map((a, i) => (
        <div class="lift" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:26px 24px">
          <div style="width:44px;height:44px;border-radius:11px;background:rgba(185,165,126,.16);display:flex;align-items:center;justify-content:center;margin-bottom:18px">
            <span style="font-family:'Cormorant Garamond',serif;font-size:22px;color:#D8C69C;font-weight:600">{a.n}</span>
          </div>
          <h3 data-i18n-group="attractions" data-i18n-index={i} data-i18n-field="title" style="font-size:24px;color:#F4EEE1;font-weight:600">{a.title}</h3>
          <p data-i18n-group="attractions" data-i18n-index={i} data-i18n-field="desc" style="font-size:14px;line-height:1.6;color:#B4B4A6;margin:8px 0 0">{a.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<div style="background:#F4EEE1;padding:clamp(22px,4vh,46px) clamp(20px,5vw,60px)"><div class="mdivider"><span class="msteps" style="width:245px;height:26px;flex:none"></span></div></div>
