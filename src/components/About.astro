---
import { Image } from 'astro:assets';
import { translations, type Lang } from '../data/content';
import { uploadImage } from '../data/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
const heroImgAlt = lang === 'en' ? 'Lavender in the garden of Soba Milica' : 'Lavanda u dvorištu Sobe Milica';
---

<section id="o-nama" style="scroll-margin-top:80px;max-width:1240px;margin:0 auto;padding:clamp(70px,11vh,140px) clamp(20px,5vw,60px)">
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(36px,6vw,80px);align-items:center">
    <div class="reveal">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
        <span style="width:34px;height:1px;background:#B98A72"></span>
        <span style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#B98A72;font-weight:600">{t.aboutLabel}</span>
      </div>
      <h2 style="font-size:clamp(34px,5vw,62px);color:#33352B">{t.aboutHeading}</h2>
      <p style="font-size:17px;line-height:1.7;color:#5E6152;margin:26px 0 0;max-width:52ch">{t.aboutP1}</p>
      <p style="font-size:17px;line-height:1.7;color:#5E6152;margin:18px 0 0;max-width:52ch">{t.aboutP2}</p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:30px">
        {t.features.map((f) => (
          <span class="chip" style="border:1px solid #E1D8C6;background:#FBF7EE;color:#5E6152;border-radius:100px;padding:9px 16px;font-size:13px;font-weight:600">{f.label}</span>
        ))}
      </div>
    </div>
    <div class="reveal" style="position:relative">
      <div class="ph" style="border-radius:20px;overflow:hidden;box-shadow:0 30px 70px rgba(60,60,40,.2)">
        <Image src={uploadImage('yard-5.JPG')} alt={heroImgAlt} widths={[480, 760, 1040]} sizes="(max-width: 768px) 100vw, 560px" format="webp" style="width:100%;height:clamp(360px,52vh,560px);object-fit:cover" />
      </div>
      <div style="position:absolute;bottom:-26px;left:-10px;background:#FBF7EE;border:1px solid #EBE3D2;border-radius:16px;padding:20px 24px;box-shadow:0 20px 44px rgba(60,60,40,.16);max-width:230px">
        <div style="font-family:'Cormorant Garamond',serif;font-size:40px;font-weight:600;color:#7E876B;line-height:1">2</div>
        <div style="font-size:13px;color:#5E6152;line-height:1.4;margin-top:4px">{t.aboutStat}</div>
      </div>
    </div>
  </div>
</section>

<div style="background:#F4EEE1;padding:clamp(22px,4vh,46px) clamp(20px,5vw,60px)"><div class="mdivider"><span class="msteps" style="width:245px;height:26px;flex:none"></span></div></div>
