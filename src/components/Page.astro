---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Rooms from './Rooms.astro';
import Garden from './Garden.astro';
import DiscoverPalic from './DiscoverPalic.astro';
import Amenities from './Amenities.astro';
import Reviews from './Reviews.astro';
import LocationSection from './LocationSection.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Lightbox from './Lightbox.astro';
import { translations, gallery, type Lang } from '../data/content';
import { uploadImage } from '../data/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];

const gal = gallery(lang);
const galleryData: Record<string, { src: string; alt: string }[]> = {};
for (const [set, photos] of Object.entries(gal)) {
  galleryData[set] = await Promise.all(
    photos.map(async (p) => {
      const optimized = await getImage({ src: uploadImage(p.file), width: 1600, format: 'webp' });
      return { src: optimized.src, alt: p.alt };
    }),
  );
}
---

<Layout lang={lang} title={t.metaTitle} description={t.metaDescription}>
  <div style="position:relative;background:#F4EEE1;overflow-x:hidden">
    <Nav lang={lang} />
    <main>
      <Hero lang={lang} />
      <About lang={lang} />
      <Rooms lang={lang} />
      <Garden lang={lang} />
      <DiscoverPalic lang={lang} />
      <Amenities lang={lang} />
      <Reviews lang={lang} />
      <LocationSection lang={lang} />
      <Contact lang={lang} />
    </main>
    <Footer lang={lang} />
    <Lightbox galleryData={galleryData} />
  </div>
</Layout>
