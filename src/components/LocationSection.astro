---
import { translations, site } from '../data/content';
const t = translations.sr;
---

<section id="lokacija" style="scroll-margin-top:80px;padding:clamp(70px,11vh,140px) clamp(20px,5vw,60px);background:#F4EEE1">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(28px,4vw,52px);align-items:stretch">
    <div class="reveal" style="display:flex;flex-direction:column;justify-content:center">
      <div data-i18n="locLabel" style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#B98A72;font-weight:600;margin-bottom:14px">{t.locLabel}</div>
      <h2 data-i18n="locHeading" style="font-size:clamp(34px,5vw,58px);color:#33352B">{t.locHeading}</h2>
      <p data-i18n="locText" style="font-size:17px;line-height:1.7;color:#5E6152;margin:20px 0 0;max-width:44ch">{t.locText}</p>
      <div style="margin-top:28px;background:#FBF7EE;border:1px solid #E4DCCB;border-radius:16px;padding:22px 24px">
        <div style="display:flex;align-items:flex-start;gap:14px">
          <svg class="icn-lg" style="stroke:#B98A72;margin-top:2px" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
          <div>
            <div style="font-weight:700;font-size:16px;color:#33352B">{site.brand}</div>
            <div style="font-size:15px;color:#5E6152;line-height:1.6;margin-top:2px">{site.addressLine1}<br>{site.addressLine2}</div>
          </div>
        </div>
      </div>
      <a class="btn" href={site.directionsUrl} target="_blank" rel="noopener" style="margin-top:18px;align-self:flex-start;background:#7E876B;color:#fff;border-radius:100px;padding:14px 26px;font-size:14px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:9px;box-shadow:0 10px 26px rgba(95,102,80,.24)">
        <span data-i18n="locBtn">{t.locBtn}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 17L17 7M9 7h8v8"></path></svg>
      </a>
    </div>
    <div class="reveal" style="border-radius:20px;overflow:hidden;box-shadow:0 26px 60px rgba(60,60,40,.18);border:1px solid #E4DCCB;min-height:380px">
      <iframe title="Mapa — Palić" src={site.mapEmbedUrl} style="width:100%;height:100%;min-height:380px;border:0;filter:saturate(.9)"></iframe>
    </div>
  </div>
</section>
