---
import { translations } from '../data/content';
const t = translations.sr;

const icons = [
  '<path d="M4.5 12a11 11 0 0 1 15 0"></path><path d="M7.5 15a7 7 0 0 1 9 0"></path><circle cx="12" cy="18.5" r="1" fill="#5F6650" stroke="none"></circle>',
  '<rect x="3" y="5" width="18" height="9" rx="2"></rect><path d="M7 18h.01"></path><path d="M12 18.5h.01"></path><path d="M17 18h.01"></path><path d="M7 9h4"></path>',
  '<circle cx="12" cy="12" r="9"></circle><path d="M10 16.5V8h3a2.4 2.4 0 0 1 0 4.8h-3"></path>',
  '<circle cx="12" cy="9" r="6"></circle><path d="M12 15v6"></path><path d="M9 19h6"></path>',
  '<path d="M12 2.5s4 3 4 7.5a4 4 0 0 1-8 0c0-2 1-3 2.5-4 .3 1.8 1.5 2 1.5 3.5"></path>',
  '<path d="M6 11V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v5"></path><rect x="5" y="11" width="14" height="4" rx="1"></rect><path d="M7 15v4"></path><path d="M17 15v4"></path>',
  '<rect x="3" y="5" width="18" height="12" rx="2"></rect><path d="M9 21h6"></path>',
  '<path d="M12 3s5 5.5 5 9.5a5 5 0 0 1-10 0C7 8.5 12 3 12 3z"></path>',
  '<path d="M4 8h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"></path><path d="M17 9h2a2 2 0 0 1 0 4h-2"></path>',
  '<circle cx="8" cy="8" r="2.2"></circle><circle cx="16" cy="8" r="2.2"></circle><path d="M4.5 19a3.5 3.5 0 0 1 7 0"></path><path d="M12.5 19a3.5 3.5 0 0 1 7 0"></path>',
  '<path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z"></path>',
];
---

<section id="sadrzaji" style="scroll-margin-top:80px;padding:clamp(70px,11vh,140px) clamp(20px,5vw,60px);background:#F4EEE1">
  <div style="max-width:1240px;margin:0 auto">
    <div class="reveal" style="text-align:center;margin-bottom:52px">
      <div class="lbl-orn" data-i18n="amenLabel" style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#B98A72;font-weight:600;margin-bottom:14px">{t.amenLabel}</div>
      <h2 data-i18n="amenHeading" style="font-size:clamp(34px,5.4vw,60px);color:#33352B">{t.amenHeading}</h2>
    </div>
    <div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px">
      {t.amenities.map((a, i) => (
        <div style="background:#FBF7EE;border:1px solid #EBE3D2;border-radius:16px;padding:26px 18px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px">
          <div style="width:52px;height:52px;border-radius:13px;background:#EFE9DB;display:flex;align-items:center;justify-content:center">
            <svg viewBox="0 0 24 24" class="icn" set:html={icons[i]}></svg>
          </div>
          <span data-i18n-group="amenities" data-i18n-index={i} style="font-size:14px;font-weight:600;color:#4b4e40">{a.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
