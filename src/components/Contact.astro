---
import { Image } from 'astro:assets';
import { translations, site, type Lang } from '../data/content';
import { uploadImage } from '../data/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<section id="kontakt" style="scroll-margin-top:80px;position:relative;padding:clamp(80px,13vh,170px) clamp(20px,5vw,60px);overflow:hidden">
  <Image class="ph" src={uploadImage('hero-2.JPG')} alt="" widths={[800, 1400, 1920]} sizes="100vw" format="webp" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(28,30,22,.72),rgba(28,30,22,.82))"></div>
  <div class="reveal" style="position:relative;z-index:2;max-width:900px;margin:0 auto;text-align:center;color:#fff">
    <div style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#D8C69C;font-weight:600;margin-bottom:16px">{t.contactLabel}</div>
    <h2 style="font-size:clamp(38px,6.5vw,80px);color:#fff">{t.contactHeading}</h2>
    <p style="font-size:18px;line-height:1.65;color:rgba(255,255,255,.9);margin:20px auto 0;max-width:52ch;font-weight:300">{t.contactSub}</p>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:40px">
      <a class="btn" href={site.bookingUrl} target="_blank" rel="noopener" style="background:#1a3a6b;color:#fff;border-radius:100px;padding:16px 30px;font-size:15px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:10px;box-shadow:0 14px 34px rgba(0,0,0,.3)">
        <span style="display:flex;align-items:center;justify-content:center;width:24px;height:24px;background:#fff;color:#1a3a6b;border-radius:5px;font-size:13px;font-weight:800">B.</span>
        Booking.com · {site.ratingScore}
      </a>
      <a class="btn" href={site.whatsappUrl} target="_blank" rel="noopener" style="background:#25a35a;color:#fff;border-radius:100px;padding:16px 30px;font-size:15px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:10px">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7a11.6 11.6 0 0 1-4.7-4.2c-.4-.5-1-1.5-1-2.9 0-1.3.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.1.1.3 0 .5l-.4.6-.3.3c-.1.2-.3.3-.1.6.2.4.8 1.3 1.6 2 1 .9 1.9 1.2 2.2 1.3.3.2.5.1.7-.1l.9-1c.2-.3.4-.2.6-.1l2 .9c.3.2.5.2.5.4.1.2.1.8-.1 1.3z"></path></svg>
        WhatsApp
      </a>
      <a class="btn" href={site.viberUrl} style="background:#7360F2;color:#fff;border-radius:100px;padding:16px 30px;font-size:15px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:10px">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.7 2 11.3c0 2.6 1.5 5 3.9 6.5l-.9 3.4a.6.6 0 0 0 .9.7l3.9-2.1c.7.1 1.5.2 2.2.2 5.5 0 10-3.7 10-8.7S17.5 3 12 3z"></path><path d="M15.8 13.4c-.2.5-1 .9-1.4.9-.4.1-.8.1-2.5-.5a8.7 8.7 0 0 1-3.5-3.1c-.3-.4-.7-1.1-.7-2.1 0-1 .5-1.5.7-1.7.2-.2.4-.2.5-.2h.4c.1 0 .3 0 .5.4l.6 1.5c.1.1.1.2 0 .4l-.3.4-.2.2c-.1.2-.2.2-.1.4.2.3.6 1 1.2 1.5.7.7 1.4.9 1.7 1 .2.1.4.1.5-.1l.7-.8c.2-.2.3-.1.5-.1l1.5.7c.2.1.4.1.4.3.1.1.1.6-.1 1z" fill="#7360F2"></path></svg>
        Viber
      </a>
      <a class="btn" href={site.phoneUrl} style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.5);border-radius:100px;padding:16px 30px;font-size:15px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:10px;backdrop-filter:blur(4px)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>
        {site.phoneDisplay}
      </a>
      <a class="btn" href={site.emailUrl} style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.5);border-radius:100px;padding:16px 30px;font-size:15px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:10px;backdrop-filter:blur(4px)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
        <span>{t.contactEmail}</span>
      </a>
    </div>
  </div>
</section>
