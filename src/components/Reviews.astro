---
import { translations, site, type Lang } from '../data/content';
import ReviewCard from './ReviewCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<section style="padding:clamp(64px,10vh,130px) clamp(20px,5vw,60px);background:#EDE6D6">
  <div style="max-width:1240px;margin:0 auto">
    <div class="reveal" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;margin-bottom:44px">
      <div>
        <div style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#B98A72;font-weight:600;margin-bottom:12px">{t.reviewsLabel}</div>
        <h2 style="font-size:clamp(32px,5vw,58px);color:#33352B">{t.reviewsHeading}</h2>
      </div>
      <a href={site.bookingReviewsUrl} target="_blank" rel="noopener" style="display:flex;align-items:center;gap:16px;background:#FBF7EE;border:1px solid #E4DCCB;border-radius:16px;padding:16px 22px;text-decoration:none">
        <div style="display:flex;align-items:center;justify-content:center;width:58px;height:58px;background:#1a3a6b;color:#fff;border-radius:12px 12px 12px 3px;font-weight:800;font-size:22px">{site.ratingScore}</div>
        <div>
          <div style="font-weight:700;font-size:15px;color:#33352B">{t.ratingWord} · Booking.com</div>
          <div style="font-size:13px;color:#6E7060">{t.reviewsCount}</div>
        </div>
      </a>
    </div>
    <div class="reveal reviews-mask" id="reviews-wrap">
      <div class="reviews-track">
        <div class="reviews-set" id="reviews-set">
          {t.reviews.map((r) => <ReviewCard review={r} />)}
        </div>
        <div class="reviews-set reviews-set-dup" aria-hidden="true">
          {t.reviews.map((r) => <ReviewCard review={r} />)}
        </div>
      </div>
    </div>
    <div class="reviews-dots" id="reviews-dots">
      {t.reviews.map((_, i) => (
        <button class={`reviews-dot${i === 0 ? ' is-active' : ''}`} data-index={i} aria-label={`${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<div style="background:#F4EEE1;padding:clamp(22px,4vh,46px) clamp(20px,5vw,60px)"><div class="mdivider"><span class="msteps" style="width:245px;height:26px;flex:none"></span></div></div>
