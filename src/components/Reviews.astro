---
import { translations, site, type Lang } from '../data/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<section style="padding:clamp(64px,10vh,130px) clamp(20px,5vw,60px);background:#EDE6D6">
  <div style="max-width:1240px;margin:0 auto">
    <div class="reveal" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;margin-bottom:44px">
      <div>
        <div style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#B98A72;font-weight:600;margin-bottom:12px">{t.reviewsLabel}</div>
        <h2 style="font-size:clamp(32px,5vw,58px);color:#33352B">{t.reviewsHeading}</h2>
      </div>
      <div style="display:flex;align-items:center;gap:16px;background:#FBF7EE;border:1px solid #E4DCCB;border-radius:16px;padding:16px 22px">
        <div style="display:flex;align-items:center;justify-content:center;width:58px;height:58px;background:#1a3a6b;color:#fff;border-radius:12px 12px 12px 3px;font-weight:800;font-size:22px">{site.ratingScore}</div>
        <div>
          <div style="font-weight:700;font-size:15px;color:#33352B">{t.ratingWord} · Booking.com</div>
          <div style="font-size:13px;color:#6E7060">{t.reviewsCount}</div>
        </div>
      </div>
    </div>
    <div class="reveal" id="reviews-wrap" style="overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)">
      <div class="reviews-track" style="display:flex;gap:20px;width:max-content">
        {[...t.reviews, ...t.reviews].map((r) => (
          <div style="flex:0 0 340px;background:#FBF7EE;border:1px solid #E4DCCB;border-radius:18px;padding:28px 26px;height:288px;display:flex;flex-direction:column;justify-content:space-between">
            <div>
              <div style="color:#C9A24B;font-size:15px;letter-spacing:3px;margin-bottom:12px">★★★★★</div>
              <p style="font-family:'Cormorant Garamond',serif;font-size:16.5px;line-height:1.48;color:#3d3f33;font-style:italic;margin:0;display:-webkit-box;-webkit-line-clamp:7;-webkit-box-orient:vertical;overflow:hidden">"<span>{r.text}</span>"</p>
            </div>
            <div style="display:flex;align-items:center;gap:12px">
              {r.photo ? (
                <img src={r.photo} alt="" width="38" height="38" loading="lazy" style="width:38px;height:38px;border-radius:50%;object-fit:cover;flex:none" />
              ) : (
                <div style="width:38px;height:38px;border-radius:50%;background:#7E876B;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex:none">{r.initial}</div>
              )}
              <div style="line-height:1.3;text-align:left">
                <div style="font-weight:700;font-size:14px;color:#33352B">{r.name}</div>
                <div style="font-size:12.5px;color:#8A8B7C">{r.origin}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<div style="background:#F4EEE1;padding:clamp(22px,4vh,46px) clamp(20px,5vw,60px)"><div class="mdivider"><span class="msteps" style="width:245px;height:26px;flex:none"></span></div></div>
