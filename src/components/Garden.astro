---
import { Image } from 'astro:assets';
import { translations, gallery, type Lang } from '../data/content';
import { uploadImage } from '../data/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
const gardenThumbs = gallery(lang).garden;
---

<section id="dvoriste" style="scroll-margin-top:80px;padding:clamp(70px,11vh,150px) clamp(20px,5vw,60px);background:#F4EEE1">
  <div style="max-width:1240px;margin:0 auto">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(30px,5vw,70px);align-items:end;margin-bottom:52px">
      <div class="reveal">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px">
          <span style="width:34px;height:1px;background:#7E876B"></span>
          <span style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#7E876B;font-weight:600">{t.gardenLabel}</span>
        </div>
        <h2 style="font-size:clamp(36px,6vw,74px);color:#33352B;max-width:14ch">{t.gardenHeading}</h2>
      </div>
      <p class="reveal" style="font-size:18px;line-height:1.75;color:#5E6152;max-width:56ch;font-weight:300">{t.gardenLead}</p>
    </div>

    <div class="reveal masonry" style="margin-bottom:44px">
      {gardenThumbs.map((g, i) => (
        <div class="thumb ph" data-gallery-set="garden" data-gallery-index={i} style="box-shadow:0 14px 34px rgba(60,60,40,.16)">
          <Image src={uploadImage(g.file)} alt={g.alt} widths={[360, 600, 900]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw" format="webp" style="width:100%" />
        </div>
      ))}
    </div>

    <div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px">
      {t.moments.map((m) => (
        <div style="display:flex;align-items:center;gap:14px;background:#FBF7EE;border:1px solid #EBE3D2;border-radius:14px;padding:18px 20px">
          <svg class="icn-lg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.4"></circle><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"></path></svg>
          <span style="font-size:14.5px;font-weight:600;color:#4b4e40;line-height:1.3">{m.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
