---
import { translations, site, type Lang } from '../data/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<div class="navwrap" id="navwrap">
  <a href="#pocetak" class="navlogo">
    <span class="navlogo-name">{site.brand}</span>
    <span class="navlogo-kicker">Palić · Vojvodina</span>
  </a>
  <nav class="navlinks">
    <a class="navlink" href="#o-nama" data-close-nav>{t.navAbout}</a>
    <a class="navlink" href="#sobe" data-close-nav>{t.navRooms}</a>
    <a class="navlink" href="#dvoriste" data-close-nav>{t.navGarden}</a>
    <a class="navlink" href="#palic" data-close-nav>Palić</a>
    <a class="navlink" href="#kontakt" data-close-nav>{t.navContact}</a>
    <div class="navlangswitch" role="group" aria-label="SR / EN">
      <a
        class={`navlangswitch-opt${lang === 'sr' ? ' is-active' : ''}`}
        href="/sr/"
        hreflang="sr"
        aria-current={lang === 'sr' ? 'page' : undefined}
      >
        <span>SR</span>
      </a>
      <a
        class={`navlangswitch-opt${lang === 'en' ? ' is-active' : ''}`}
        href="/en/"
        hreflang="en"
        aria-current={lang === 'en' ? 'page' : undefined}
      >
        <span>EN</span>
      </a>
    </div>
    <a
      class="btn navcta-desktop"
      href={site.bookingUrl}
      target="_blank"
      rel="noopener"
      style="background:#7E876B;color:#fff;border-radius:100px;padding:11px 22px;font-size:13px;font-weight:700;letter-spacing:.02em;box-shadow:0 8px 24px rgba(95,102,80,.28)"
    >
      {t.navBook}
    </a>
  </nav>
  <button class="btn burger" id="nav-burger" aria-label="Menu" type="button" style="background:transparent;border:none;width:40px;height:40px;flex-direction:column;justify-content:center;gap:5px;z-index:61;align-items:center">
    <span class="burger-line" style="display:block;width:24px;height:2px;border-radius:2px"></span>
    <span class="burger-line" style="display:block;width:24px;height:2px;border-radius:2px"></span>
    <span class="burger-line" style="display:block;width:16px;height:2px;border-radius:2px"></span>
  </button>
</div>
