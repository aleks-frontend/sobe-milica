---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Rooms from '../components/Rooms.astro';
import Garden from '../components/Garden.astro';
import DiscoverPalic from '../components/DiscoverPalic.astro';
import Amenities from '../components/Amenities.astro';
import Reviews from '../components/Reviews.astro';
import LocationSection from '../components/LocationSection.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
---

<Layout
  title="Soba Milica — Palić, Vojvodina | Sobe za izdavanje"
  description="Porodično prenoćište Soba Milica u Paliću — dve udobne sobe, veliko zeleno dvorište i topla domaćinska dobrodošlica, na par minuta od jezera i Subotice."
>
  <div style="position:relative;background:#F4EEE1;overflow-x:hidden">
    <Nav />
    <Hero />
    <About />
    <Rooms />
    <Garden />
    <DiscoverPalic />
    <Amenities />
    <Reviews />
    <LocationSection />
    <Contact />
    <Footer />
    <Lightbox />
  </div>
</Layout>
